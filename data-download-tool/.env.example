# Credentials for the open and access-restricted datasets.
#
# Copy this file to `.env` (same folder as your notebook, or anywhere above it) and
# fill in the tokens you have been given. `.env` is gitignored - never commit it.

# Read-only SAS token for the default 'zarr' container (open datasets). Request it
# from the data owner. If unset, the downloader falls back to anonymous access.
PDP_DEFAULT_SAS=

# SAS token for the restricted 'external-shared-after-end' container.
# Used by catalog entries with `credential_env: PDP_AFTER_END_SAS`
# (category `restricted_partner`). Request it from the data owner.
PDP_AFTER_END_SAS=
