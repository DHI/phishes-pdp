{
  // Markdownlint config for this repo
  "config": {
    "default": true,
    "MD001": false,
    "MD024": { "siblings_only": true },
    "MD010": false,
    "MD012": false,
    "MD013": false,
    "MD022": false,
    "MD026": false,
    "MD031": false,
    "MD032": false,
    "MD034": false,
    "MD036": false,
    "MD040": false,
    // Stub READMEs for not-yet-implemented model trains are prose, and
    // demanding a top-level heading on them is friction with no payoff.
    "MD041": false,
    "MD051": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "model-trains/hydrus-1d+modflow6/**",
    "model-trains/MODFLOW6-reservoir-model/**"
  ]
}
